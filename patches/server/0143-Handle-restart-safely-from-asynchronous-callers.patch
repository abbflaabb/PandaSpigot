From: Manus <dev-agent@manus.ai>
Date: Sat, 17 Oct 2026 00:14:42 +0300
Subject: [PATCH] Handle restart safely from asynchronous callers

Co-authored-by: Manus <dev-agent@manus.ai>
---
 .../net/minecraft/server/MinecraftServer.java |  12 +-
 .../java/net/minecraft/server/PlayerList.java |   7 +-
 .../java/org/spigotmc/RestartCommand.java     | 174 +++++++++++-------
 3 files changed, 121 insertions(+), 72 deletions(-)

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index a132a29f8..90717eeb1 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -69,6 +69,7 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
     public WorldServer[] worldServer;
     private PlayerList v;
     private boolean isRunning = true;
+    private boolean isRestarting = false;
     private boolean isStopped;
     private int ticks;
     protected final Proxy e;
@@ -479,7 +480,7 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
             if (this.v != null) {
                 MinecraftServer.LOGGER.info("Saving players");
                 this.v.savePlayers();
-                this.v.u();
+                this.v.u(this.isRestarting);
                 try { Thread.sleep(100); } catch (InterruptedException ex) {} // CraftBukkit - SPIGOT-625 - give server at least a chance to send packets
             }
 
@@ -522,7 +523,16 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
     }
 
     public void safeShutdown() {
+        this.safeShutdown(false);
+    }
+
+    public void safeShutdown(boolean isRestarting) {
         this.isRunning = false;
+        this.isRestarting = isRestarting;
+    }
+
+    public boolean isRestarting() {
+        return this.isRestarting;
     }
 
     // PaperSpigot start - Further improve tick loop
diff --git a/src/main/java/net/minecraft/server/PlayerList.java b/src/main/java/net/minecraft/server/PlayerList.java
index 7668ba107..4e6eb9a24 100644
--- a/src/main/java/net/minecraft/server/PlayerList.java
+++ b/src/main/java/net/minecraft/server/PlayerList.java
@@ -1203,9 +1203,14 @@ public abstract class PlayerList {
     }
 
     public void u() {
+        this.u(false);
+    }
+
+    public void u(boolean isRestarting) {
         // PandaSpigot start - Fix SPIGOT-2622: Only one player receiving the server shutdown message
+        String shutdownMessage = isRestarting ? org.spigotmc.SpigotConfig.restartMessage : this.server.server.getShutdownMessage();
         for (EntityPlayer player : this.players) {
-            player.playerConnection.disconnect(this.server.server.getShutdownMessage()); // CraftBukkit - add custom shutdown message
+            player.playerConnection.disconnect(shutdownMessage); // CraftBukkit - add custom shutdown message
         // PandaSpigot end
         }
 
diff --git a/src/main/java/org/spigotmc/RestartCommand.java b/src/main/java/org/spigotmc/RestartCommand.java
index 80fdb61dc..a398c1bf0 100644
--- a/src/main/java/org/spigotmc/RestartCommand.java
+++ b/src/main/java/org/spigotmc/RestartCommand.java
@@ -45,89 +45,123 @@ public class RestartCommand extends Command
         AsyncCatcher.enabled = false; // Disable async catcher incase it interferes with us
         try
         {
-            if ( script.isFile() )
+            boolean isRestarting = addShutdownHook(script);
+            if (isRestarting)
             {
-                System.out.println( "Attempting to restart with " + SpigotConfig.restartScript );
+                System.out.println("Attempting to restart with " + SpigotConfig.restartScript);
+            } else
+            {
+                System.out.println("Startup script '" + SpigotConfig.restartScript + "' does not exist! Stopping server.");
+            }
 
-                // Disable Watchdog
-                WatchdogThread.doStop();
+            // Disable Watchdog
+            WatchdogThread.doStop();
+            shutdownServer(isRestarting);
+        } catch (Exception ex)
+        {
+            ex.printStackTrace();
+        }
+    }
 
-                // Kick all players
-                for ( EntityPlayer p : (List< EntityPlayer>) MinecraftServer.getServer().getPlayerList().players )
-                {
-                    p.playerConnection.disconnect(SpigotConfig.restartMessage);
-                }
-                // Give the socket a chance to send the packets
-                try
-                {
-                    Thread.sleep( 100 );
-                } catch ( InterruptedException ex )
-                {
-                }
-                // Close the socket so we can rebind with the new process
-                MinecraftServer.getServer().getServerConnection().b();
+    private static void shutdownServer(boolean isRestarting)
+    {
+        MinecraftServer server = MinecraftServer.getServer();
+        if (Thread.currentThread() == server.aM())
+        {
+            // Kick all players from a snapshot because disconnect removes players from the live list.
+            String message = isRestarting ? SpigotConfig.restartMessage : server.server.getShutdownMessage();
+            for (EntityPlayer player : (List<EntityPlayer>) com.google.common.collect.ImmutableList.copyOf(server.getPlayerList().players))
+            {
+                player.playerConnection.disconnect(message);
+            }
 
-                // Give time for it to kick in
-                try
-                {
-                    Thread.sleep( 100 );
-                } catch ( InterruptedException ex )
-                {
-                }
+            // Give the socket a chance to send the packets
+            try
+            {
+                Thread.sleep(100);
+            } catch (InterruptedException ignored)
+            {
+            }
+            server.safeShutdown(isRestarting);
+            closeSocket();
 
-                // Actually shutdown
-                try
-                {
-                    MinecraftServer.getServer().stop();
-                } catch ( Throwable t )
-                {
-                }
+            // Actually shutdown
+            try
+            {
+                server.stop();
+            } catch (Throwable ignored)
+            {
+            }
+
+            // Stop the JVM after server shutdown has completed
+            System.exit(0);
+        } else
+        {
+            // Let the server thread perform the shutdown so world/player state is not touched asynchronously.
+            server.safeShutdown(isRestarting);
 
-                // This will be done AFTER the server has completely halted
-                Thread shutdownHook = new Thread()
+            // Wait for the server to enter a safe shutdown state; a deadlocked server is force-stopped after 10 seconds.
+            try
+            {
+                Thread.sleep(10000);
+            } catch (InterruptedException ignored)
+            {
+            }
+
+            if (server.isStopped()) return;
+
+            closeSocket();
+            System.exit(0);
+        }
+    }
+
+    private static void closeSocket()
+    {
+        // Close the socket so we can rebind with the new process
+        MinecraftServer.getServer().getServerConnection().b();
+
+        // Give time for it to kick in
+        try
+        {
+            Thread.sleep(100);
+        } catch (InterruptedException ignored)
+        {
+        }
+    }
+
+    private static boolean addShutdownHook(final File script)
+    {
+        if (script.isFile())
+        {
+            Thread shutdownHook = new Thread()
+            {
+                @Override
+                public void run()
                 {
-                    @Override
-                    public void run()
+                    try
                     {
-                        try
+                        String os = System.getProperty("os.name").toLowerCase(java.util.Locale.ENGLISH);
+                        if (os.contains("win"))
                         {
-                            String os = System.getProperty( "os.name" ).toLowerCase();
-                            if ( os.contains( "win" ) )
-                            {
-                                Runtime.getRuntime().exec( "cmd /c start " + script.getPath() );
-                            } else
-                            {
-                                Runtime.getRuntime().exec( new String[]
-                                {
-                                    "sh", script.getPath()
-                                } );
-                            }
-                        } catch ( Exception e )
+                            Runtime.getRuntime().exec("cmd /c start " + script.getPath());
+                        } else
                         {
-                            e.printStackTrace();
+                            Runtime.getRuntime().exec(new String[]
+                            {
+                                "sh", script.getPath()
+                            });
                         }
+                    } catch (Exception e)
+                    {
+                        e.printStackTrace();
                     }
-                };
-
-                shutdownHook.setDaemon( true );
-                Runtime.getRuntime().addShutdownHook( shutdownHook );
-            } else
-            {
-                System.out.println( "Startup script '" + SpigotConfig.restartScript + "' does not exist! Stopping server." );
-
-                // PandaSpigot start - Proper shutdown when restart script does not exist
-                try
-                {
-                    MinecraftServer.getServer().stop();
-                } catch (Throwable t)
-                {
                 }
-                // PandaSpigot end
-            }
-            System.exit( 0 );
-        } catch ( Exception ex )
-        {
-            ex.printStackTrace();
+            };
+
+            shutdownHook.setDaemon(true);
+            Runtime.getRuntime().addShutdownHook(shutdownHook);
+            return true;
         }
+        return false;
     }
 }
