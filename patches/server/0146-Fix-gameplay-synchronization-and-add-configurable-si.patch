@@ -0,0 +1,47 @@
+package net.minecraft.server;
+
+import io.netty.buffer.Unpooled;
+import java.time.Duration;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class TitleTimingTest {
+    @Test
+    public void retainsNormalAndUnchangedTimes() throws Exception {
+        assertTimes(new PacketPlayOutTitle(10, 70, 20), 10, 70, 20);
+        assertTimes(new PacketPlayOutTitle(-1, 0, -1), -1, 0, -1);
+    }
+
+    @Test
+    public void capsEachPhaseSoPartialUpdatesCannotOverflowClientTotal() throws Exception {
+        int limit = PacketPlayOutTitle.MAX_TITLE_TICKS;
+        assertTrue(3L * limit <= Integer.MAX_VALUE);
+        assertTimes(new PacketPlayOutTitle(Integer.MAX_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE), limit, limit, limit);
+        assertTimes(new PacketPlayOutTitle(-1, Integer.MAX_VALUE, -1), -1, limit, -1);
+    }
+
+    @Test
+    public void convertsAdventureDurationsWithoutLongOrIntegerOverflow() {
+        assertEquals(30, PacketPlayOutTitle.durationToTicks(Duration.ofMillis(1500)));
+        assertEquals(0, PacketPlayOutTitle.durationToTicks(Duration.ofNanos(49999999)));
+        assertEquals(1, PacketPlayOutTitle.durationToTicks(Duration.ofMillis(50)));
+        assertEquals(-1, PacketPlayOutTitle.durationToTicks(Duration.ofMillis(-1)));
+        assertEquals(PacketPlayOutTitle.MAX_TITLE_TICKS, PacketPlayOutTitle.durationToTicks(Duration.ofSeconds(Long.MAX_VALUE)));
+    }
+
+    private void assertTimes(PacketPlayOutTitle packet, int fadeIn, int stay, int fadeOut) throws Exception {
+        PacketDataSerializer buffer = new PacketDataSerializer(Unpooled.buffer());
+        try {
+            packet.b(buffer);
+            assertEquals(PacketPlayOutTitle.EnumTitleAction.TIMES, buffer.a(PacketPlayOutTitle.EnumTitleAction.class));
+            assertEquals(fadeIn, buffer.readInt());
+            assertEquals(stay, buffer.readInt());
+            assertEquals(fadeOut, buffer.readInt());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+}
