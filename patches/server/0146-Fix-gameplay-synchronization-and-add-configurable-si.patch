+    public void removingWeaponBeforeSaveDoesNotPersistItsDamage() throws Exception {
+        TestEntity entity = new TestEntity();
+        applyEquipment(entity, new ItemStack(Items.DIAMOND_SWORD));
+        entity.setEquipment(0, null); // Death/quit clears inventory before the equipment tick.
+        double damageBeforeSave = entity.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue();
+
+        NBTTagCompound saved = new NBTTagCompound();
+        entity.b(saved);
+
+        TestEntity loaded = new TestEntity();
+        GenericAttributes.a(loaded.getAttributeMap(), saved.getList("Attributes", 10));
+        assertEquals(1.0D, loaded.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue(), 0.0D);
+        assertEquals(damageBeforeSave, entity.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue(), 0.0D);
+    }
+
+    @Test
+    public void newlyEquippedWeaponIsNotAppliedBySaving() {
+        TestEntity entity = new TestEntity();
+        entity.setEquipment(0, new ItemStack(Items.DIAMOND_SWORD));
+        entity.b(new NBTTagCompound());
+        assertEquals(1.0D, entity.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue(), 0.0D);
+    }
+
+    @Test
+    public void serializationFailureRestoresAppliedModifiers() throws Exception {
+        TestEntity entity = new TestEntity();
+        applyEquipment(entity, new ItemStack(Items.DIAMOND_SWORD));
+        double damage = entity.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue();
+        try {
+            entity.b(new NBTTagCompound() {
+                @Override
+                public void set(String name, NBTBase value) {
+                    if ("Attributes".equals(name)) throw new IllegalStateException("save failed");
+                    super.set(name, value);
+                }
+            });
+            fail("Expected save failure");
+        } catch (IllegalStateException expected) {
+            assertEquals("save failed", expected.getMessage());
+        }
+        assertEquals(damage, entity.getAttributeInstance(GenericAttributes.ATTACK_DAMAGE).getValue(), 0.0D);
+    }
+
+    private static void applyEquipment(TestEntity entity, ItemStack stack) throws Exception {
+        entity.setEquipment(0, stack);
+        entity.getAttributeMap().b(stack.B());
+        Field equipmentCache = EntityLiving.class.getDeclaredField("h");
+        equipmentCache.setAccessible(true);
+        ((ItemStack[]) equipmentCache.get(entity))[0] = stack.cloneItemStack();
+    }
+
+    private static class TestEntity extends EntityLiving {
+        private final ItemStack[] equipment = new ItemStack[5];
+
+        TestEntity() { super(null); }
+
+        @Override
+        protected void initAttributes() {
+            super.initAttributes();
+            getAttributeMap().b(GenericAttributes.ATTACK_DAMAGE).setValue(1.0D);
+        }
+
+        @Override public ItemStack bA() { return equipment[0]; }
+        @Override public ItemStack getEquipment(int slot) { return equipment[slot]; }
