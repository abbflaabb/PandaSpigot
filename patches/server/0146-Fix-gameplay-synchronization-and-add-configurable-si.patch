+package net.minecraft.server;
+
+import io.netty.buffer.Unpooled;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class WritableBookPacketTest extends AbstractTestingBase {
+    @Test
+    public void namedBlankBookHasAnEditablePageOnTheWire() throws Exception {
+        ItemStack book = new ItemStack(Items.WRITABLE_BOOK);
+        book.c("Notebook");
+        NBTTagCompound original = (NBTTagCompound) book.getTag().clone();
+
+        ItemStack received = roundTrip(book);
+
+        assertEquals("Notebook", received.getName());
+        assertTrue(ItemBookAndQuill.b(received.getTag()));
+        assertEquals(1, received.getTag().getList("pages", 8).size());
+        assertEquals("", received.getTag().getList("pages", 8).getString(0));
+        assertEquals(original, book.getTag());
+    }
+
+    @Test
+    public void existingPagesArePreserved() throws Exception {
+        ItemStack book = new ItemStack(Items.WRITABLE_BOOK);
+        NBTTagList pages = new NBTTagList();
+        pages.add(new NBTTagString("Already written"));
+        book.a("pages", pages);
+
+        assertEquals("Already written", roundTrip(book).getTag().getList("pages", 8).getString(0));
+    }
+
+    private static ItemStack roundTrip(ItemStack book) throws Exception {
+        PacketDataSerializer buffer = new PacketDataSerializer(Unpooled.buffer());
+        try {
+            buffer.a(book);
+            return buffer.i();
+        } finally {
+            buffer.release();
+        }
+    }
+}
