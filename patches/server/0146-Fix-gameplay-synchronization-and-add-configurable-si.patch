@@ -0,0 +1,36 @@
+package com.hpfxd.pandaspigot.config;
+
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+
+/** Opt-in simulation controls for static worlds. Defaults retain normal gameplay. */
+@ConfigSerializable
+public class WorldPerformanceConfig {
+    @Comment("Pause simulation while this world has no players. Chunk unloading and saving still run.")
+    public boolean pauseWhenEmpty = false;
+    @Comment("Skip random chunk ticks, thunder, ice/snow and chunk lighting maintenance. Scheduled blocks still tick.")
+    public boolean disableChunkTicking = false;
+    public boolean disableTileEntityTicking = false;
+    @Comment("Freeze weather timers and transitions; does not clear existing rain or prevent plugin changes.")
+    public boolean disableWeatherTicking = false;
+    public boolean disableNaturalLightning = false;
+    public boolean disableNaturalMobSpawning = false;
+    @Comment("Reject new villagers and freeze existing villagers, preserving their saved data.")
+    public boolean disableVillagers = false;
+    @Comment("Freeze non-player entity simulation. Existing entities remain visible and collidable.")
+    public boolean disableNonPlayerEntityTicking = false;
+    @Comment("Stop periodic entity tracking updates. Initial spawns and removals still work; moving entities appear frozen.")
+    public boolean disableEntityTrackingUpdates = false;
+    @Comment("Keep sand/gravel/anvils static and freeze existing falling-block entities. Re-enable before resuming gameplay.")
+    public boolean disableFallingBlockPhysics = false;
+    public boolean disableLiquidFlow = false;
+    public boolean disableLeafDecay = false;
+    @Comment("Skip scheduled redstone component ticks (repeaters, comparators, torches, lamps, buttons, pressure plates, tripwires and dispensers). Direct interactions still work. Re-enabling may require updating circuits.")
+    public boolean disableRedstoneTicking = false;
+    @Comment("Use xorshift64* for the world's Random. Requires a world reload/restart, changes random outcomes, and is not guaranteed to improve every workload. Default preserves Java Random.")
+    public boolean useFastRandom = false;
+
+    public boolean shouldPause(int playerCount) {
+        return pauseWhenEmpty && playerCount == 0;
+    }
+}
