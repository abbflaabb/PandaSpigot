index 0000000000000000000000000000000000000000..3e0d9171cf8614ceada538484755483aaa9be39b
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/XorShiftRandom.java
@@ -0,0 +1,34 @@
+package com.hpfxd.pandaspigot;
+
+import java.util.Random;
+
+/** Optional xorshift64* generator for world simulation, never authentication. */
+public final class XorShiftRandom extends Random {
+    private static final long serialVersionUID = 1L;
+    private long state;
+
+    public XorShiftRandom() {
+        this(new Random().nextLong());
+    }
+
+    public XorShiftRandom(long seed) {
+        super(seed);
+    }
+
+    @Override
+    public synchronized void setSeed(long seed) {
+        // Retain Random's Gaussian cache reset and serialized superclass state.
+        super.setSeed(seed);
+        this.state = seed == 0 ? 0x9E3779B97F4A7C15L : seed;
+    }
+
+    @Override
+    protected synchronized int next(int bits) {
+        long value = this.state;
+        value ^= value >>> 12;
+        value ^= value << 25;
+        value ^= value >>> 27;
+        this.state = value;
+        return (int) ((value * 0x2545F4914F6CDD1DL) >>> (64 - bits));
+    }
+}
