+package com.hpfxd.pandaspigot;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class TickTimeSamplerTest {
+    @Test
+    public void countsOnlyCompletedSamplesAndEvictsOldestAfterOneHundredTicks() {
+        TickTimeSampler sampler = new TickTimeSampler();
+        assertEquals(0, sampler.getMspt(), 0);
+        sampler.record(10_000_000);
+        assertEquals(10, sampler.getMspt(), 0);
+        sampler.record(30_000_000);
+        assertEquals(20, sampler.getMspt(), 0);
+        for (int i = 0; i < 100; i++) sampler.record(2_000_000);
+        assertEquals(2, sampler.getMspt(), 0);
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void rejectsNegativeDurations() {
+        new TickTimeSampler().record(-1);
+    }
+}
