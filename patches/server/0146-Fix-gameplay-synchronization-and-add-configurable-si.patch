index 0000000000000000000000000000000000000000..7c7eb699ac9d4a0042dd2dc6d64dc7626978e373
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/config/ServerPerformanceConfig.java
@@ -0,0 +1,25 @@
+package com.hpfxd.pandaspigot.config;
+
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+
+@ConfigSerializable
+public class ServerPerformanceConfig {
+    @Comment("Target ticks per second (1-20). This also slows plugin tick timers, gameplay and connection housekeeping.")
+    public int tickRate = 20;
+    @Comment("Use idleTickRate while no players are online. A joining player restores tickRate on the next tick.")
+    public boolean hibernateWhenEmpty = false;
+    public int idleTickRate = 1;
+    @Comment("Stop periodic tab-list latency broadcasts. Keepalive and actual connection latency measurement remain enabled.")
+    public boolean disableTabListPingUpdates = false;
+
+    public void validate() {
+        if (tickRate < 1 || tickRate > 20 || idleTickRate < 1 || idleTickRate > tickRate) {
+            throw new IllegalArgumentException("performance tickRate must be 1-20 and idleTickRate must be 1-tickRate");
+        }
+    }
+
+    public long tickIntervalNanos(int playerCount) {
+        return 1_000_000_000L / (hibernateWhenEmpty && playerCount == 0 ? idleTickRate : tickRate);
+    }
+}
