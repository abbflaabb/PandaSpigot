+        manager.setAccessible(true);
+        manager.set(world, new PlayerChunkMap(world, distance));
+        return world;
+    }
+
+    @Test
+    public void defaultDistanceFollowsWorldTransferAndWorldChanges() throws Exception {
+        EntityPlayer player = allocate(EntityPlayer.class);
+        player.setViewDistance(-1);
+        player.world = world(10);
+        assertEquals(10, player.getViewDistance());
+        player.world = world(5);
+        assertEquals(5, player.getViewDistance());
+        player.u().getPlayerChunkMap().a(7);
+        assertEquals(7, player.getViewDistance());
+    }
+
+    @Test
+    public void explicitOverrideSurvivesWorldChangesAndCanBeReset() throws Exception {
+        EntityPlayer player = allocate(EntityPlayer.class);
+        player.world = world(10);
+        PlayerChunkMap map = player.u().getPlayerChunkMap();
+        // This player is not subscribed yet, as during login or transfer.
+        Field queue = EntityPlayer.class.getDeclaredField("chunkCoordIntPairQueue");
+        queue.setAccessible(true);
+        queue.set(player, new java.util.LinkedList<ChunkCoordIntPair>());
+        map.updateViewDistance(player, 4);
+        map.a(8);
+        assertEquals(4, player.getViewDistance());
+        map.updateViewDistance(player, -1);
+        assertEquals(8, player.getViewDistance());
+        assertEquals(-1, player.viewDistance);
+    }
+
+    @Test
