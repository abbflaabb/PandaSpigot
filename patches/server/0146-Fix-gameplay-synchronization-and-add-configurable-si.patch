+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class KnockbackProfileTest extends AbstractTestingBase {
+    @Test
+    public void legacyDefaultsProduceTheSameVelocityAndDisabledPreservesMotion() {
+        EntityLiving victim = victim(new PandaSpigotWorldConfig());
+        victim.motX = 0.2D;
+        victim.motZ = 0.4D;
+        victim.a(null, 1, 1, 0);
+        assertEquals(-0.3D, victim.motX, 0.0000001D);
+        assertEquals(0.4D, victim.motY, 0.0D);
+        assertEquals(0.2D, victim.motZ, 0.0D);
+        victim.world.pandaSpigotConfig.knockback.enabled = false;
+        victim.a(null, 1, 1, 0);
+        assertEquals(-0.3D, victim.motX, 0.0000001D);
+        assertEquals(0.4D, victim.motY, 0.0D);
+    }
+
+    @Test
+    public void namedProfileAndSeparateFrictionApplyToTheVictim() {
+        PandaSpigotWorldConfig worldConfig = new PandaSpigotWorldConfig();
+        KnockbackConfig profile = new KnockbackConfig();
+        profile.frictionHorizontal = 4.0D;
+        profile.frictionVertical = 1.0D;
+        profile.horizontal = 0.2D;
+        profile.vertical = 0.1D;
+        worldConfig.knockbackProfiles.put("practice", profile);
+        EntityLiving victim = victim(worldConfig);
+        victim.knockbackProfile = "practice";
+        victim.motX = 0.4D;
+        victim.motY = 0.1D;
+        victim.a(null, 1, 1, 0);
+        assertEquals(-0.1D, victim.motX, 0.0000001D);
+        assertEquals(0.2D, victim.motY, 0.0000001D);
+    }
+
+    @Test
+    public void profileApiFollowsWorldDefaultsAndValidatesNames() {
+        EntityPlayer handle = mock(EntityPlayer.class);
+        handle.world = mock(World.class);
+        handle.world.pandaSpigotConfig = new PandaSpigotWorldConfig();
+        handle.world.pandaSpigotConfig.knockbackProfiles.put("practice", new KnockbackConfig());
+        handle.world.pandaSpigotConfig.defaultKnockbackProfile = "practice";
+        CraftPlayer player = mock(CraftPlayer.class);
+        when(player.getHandle()).thenReturn(handle);
+        when(player.getKnockbackProfile()).thenCallRealMethod();
+        when(player.getAvailableKnockbackProfiles()).thenCallRealMethod();
+        doCallRealMethod().when(player).setKnockbackProfile(anyString());
+        doCallRealMethod().when(player).setKnockbackProfile(isNull());
+
+        assertEquals("practice", player.getKnockbackProfile());
+        player.setKnockbackProfile("default");
+        assertEquals("default", player.getKnockbackProfile());
+        player.setKnockbackProfile(null);
+        assertEquals("practice", player.getKnockbackProfile());
+        player.setKnockbackProfile("practice");
+        handle.world.pandaSpigotConfig = new PandaSpigotWorldConfig(); // A different world without that profile.
+        assertEquals("default", player.getKnockbackProfile());
+        assertTrue(player.getAvailableKnockbackProfiles().contains("default"));
+        try {
+            player.setKnockbackProfile("missing");
+            fail("Missing profiles must be rejected");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test
+    public void configuredRangesStayWithinBoundsAndRejectZeroFriction() {
+        KnockbackConfig profile = new KnockbackConfig();
+        profile.horizontalMin = 0.1D;
+        profile.horizontalMax = 0.3D;
+        profile.validate();
+        Random random = new Random(1);
+        for (int i = 0; i < 50; i++) {
+            double value = profile.horizontal(random);
+            assertTrue(value >= 0.1D && value <= 0.3D);
+        }
+        profile.frictionVertical = 0.0D;
+        try {
+            profile.validate();
+            fail("Zero friction would corrupt velocity");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    private static EntityLiving victim(PandaSpigotWorldConfig config) {
+        EntityLiving victim = mock(EntityLiving.class);
+        victim.world = mock(World.class);
+        victim.world.pandaSpigotConfig = config;
+        victim.random = new Random(1);
+        AttributeInstance resistance = mock(AttributeInstance.class);
+        when(victim.getAttributeInstance(GenericAttributes.c)).thenReturn(resistance);
+        when(victim.getKnockbackConfig()).thenCallRealMethod();
+        doCallRealMethod().when(victim).a(any(), anyFloat(), anyDouble(), anyDouble());
+        return victim;
+    }
+}
