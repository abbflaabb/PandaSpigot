new file mode 100644
index 0000000000000000000000000000000000000000..f03280d7367ae63094c10bd17d9c2dfb6b786c46
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/TickTimeSampler.java
@@ -0,0 +1,22 @@
+package com.hpfxd.pandaspigot;
+
+/** Thread-safe mean duration of the last 100 completed ticks, excluding tick-loop waiting. */
+public final class TickTimeSampler {
+    private final long[] samples = new long[100];
+    private int index;
+    private int size;
+    private long total;
+
+    public synchronized void record(long nanos) {
+        if (nanos < 0) throw new IllegalArgumentException("Negative tick duration");
+        total -= samples[index];
+        samples[index] = nanos;
+        total += nanos;
+        index = (index + 1) % samples.length;
+        if (size < samples.length) size++;
+    }
+
+    public synchronized double getMspt() {
+        return size == 0 ? 0 : total / (double) size / 1_000_000.0;
+    }
+}
