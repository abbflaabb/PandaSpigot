--- /dev/null
+++ b/src/test/java/com/hpfxd/pandaspigot/XorShiftRandomTest.java
@@ -0,0 +1,46 @@
+package com.hpfxd.pandaspigot;
+
+import java.io.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class XorShiftRandomTest {
+    @Test
+    public void zeroSeedDoesNotGetStuckAndReseedingResetsGaussianCache() {
+        XorShiftRandom random = new XorShiftRandom(0);
+        long first = random.nextLong();
+        assertNotEquals(0L, first);
+        assertNotEquals(first, random.nextLong());
+        random.setSeed(42);
+        double gaussian = random.nextGaussian();
+        random.setSeed(42);
+        assertEquals(gaussian, random.nextGaussian(), 0);
+    }
+
+    @Test
+    public void seededSequencesAreReproducibleAndRespectRandomBounds() {
+        XorShiftRandom first = new XorShiftRandom(123);
+        XorShiftRandom second = new XorShiftRandom(123);
+        for (int i = 0; i < 10000; i++) {
+            int value = first.nextInt(37);
+            assertTrue(value >= 0 && value < 37);
+            assertEquals(value, second.nextInt(37));
+            double d = first.nextDouble();
+            assertTrue(d >= 0 && d < 1);
+            assertEquals(d, second.nextDouble(), 0);
+        }
+    }
+
+    @Test
+    public void serializationPreservesSequence() throws Exception {
+        XorShiftRandom random = new XorShiftRandom(9);
+        random.nextLong();
+        ByteArrayOutputStream data = new ByteArrayOutputStream();
+        try (ObjectOutputStream out = new ObjectOutputStream(data)) { out.writeObject(random); }
+        XorShiftRandom restored;
+        try (ObjectInputStream in = new ObjectInputStream(new ByteArrayInputStream(data.toByteArray()))) {
+            restored = (XorShiftRandom) in.readObject();
+        }
+        assertEquals(random.nextLong(), restored.nextLong());
+    }
+}
