+package net.minecraft.server;
+
+import org.bukkit.block.Block;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.plugin.PluginManager;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+import static org.junit.Assert.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+public class EnchantSynchronizationTest extends AbstractTestingBase {
+    @Test
+    public void enchantmentIsSentBeforeTheNextInventoryTick() throws Exception {
+        EntityPlayer player = mock(EntityPlayer.class);
+        player.inventory = new PlayerInventory(player);
+        player.abilities = new PlayerAbilities();
+        player.expLevel = 30;
+        CraftPlayer bukkitPlayer = mock(CraftPlayer.class);
+        when(player.getBukkitEntity()).thenReturn(bukkitPlayer);
+        when(player.cj()).thenReturn(123);
+        World world = mock(World.class);
+        CraftWorld craftWorld = mock(CraftWorld.class);
+        // CraftServer is final and its constructor starts a live server. Allocate only
+        // the event-dispatch fixture used here, without changing the production class.
+        Class<?> unsafeClass = Class.forName("sun.misc.Unsafe");
+        java.lang.reflect.Field unsafeField = unsafeClass.getDeclaredField("theUnsafe");
+        unsafeField.setAccessible(true);
+        CraftServer server = (CraftServer) unsafeClass.getMethod("allocateInstance", Class.class)
+                .invoke(unsafeField.get(null), CraftServer.class);
+        java.lang.reflect.Field managerField = CraftServer.class.getDeclaredField("pluginManager");
+        managerField.setAccessible(true);
+        managerField.set(server, new org.bukkit.plugin.SimplePluginManager(null, null));
+        when(world.getWorld()).thenReturn(craftWorld);
+        Block block = mock(Block.class);
+        when(craftWorld.getBlockAt(anyInt(), anyInt(), anyInt())).thenReturn(block);
+        when(world.getServer()).thenReturn(server);
+        ContainerEnchantTable container = new ContainerEnchantTable(player.inventory, world, BlockPosition.ZERO);
+        container.enchantSlots.setItem(0, new ItemStack(Items.DIAMOND_SWORD));
+        container.enchantSlots.setItem(1, new ItemStack(Items.DYE, 3, 4));
+        ICrafting listener = mock(ICrafting.class);
+        container.addSlotListener(listener);
+        // Move beyond the first periodic NBT comparison and clear initial slot notifications.
+        container.b();
+        clearInvocations(listener);
+
+        assertTrue(container.a(player, 0));
+
+        org.mockito.ArgumentCaptor<ItemStack> sent = org.mockito.ArgumentCaptor.forClass(ItemStack.class);
+        verify(listener, atLeastOnce()).a(eq(container), eq(0), sent.capture());
+        assertTrue(sent.getValue().hasEnchantments());
+        assertEquals(2, container.enchantSlots.getItem(1).count);
+    }
+}
