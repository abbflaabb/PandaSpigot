+package net.minecraft.server;
+
+import io.netty.buffer.Unpooled;
+import io.netty.handler.codec.DecoderException;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+public class SignPacketTest {
+    @Test
+    public void preservesLiteralTextAndSiblings() {
+        assertEquals("hello world", PacketPlayInUpdateSign.readLiteralLine(
+            "{\"text\":\"hello\",\"bold\":true,\"extra\":[\" \",{\"text\":\"world\"}]}"));
+        assertEquals("\uD83D\uDC3C", PacketPlayInUpdateSign.readLiteralLine("\"\\ud83d\\udc3c\""));
+        assertEquals("", PacketPlayInUpdateSign.readLiteralLine("{\"text\":\"\"}"));
+    }
+
+    @Test(expected = DecoderException.class, timeout = 1000)
+    public void rejectsAmplifyingTranslationsBeforeResolvingThem() {
+        String json = "\"x\"";
+        for (int i = 0; i < 7; ++i) {
+            json = "{\"translate\":\"%1$s%1$s%1$s%1$s\",\"with\":[" + json + "]}";
+        }
+        PacketPlayInUpdateSign.readLiteralLine(json);
+    }
+
+    @Test(expected = DecoderException.class)
+    public void rejectsDynamicSiblings() {
+        PacketPlayInUpdateSign.readLiteralLine("{\"text\":\"\",\"extra\":[{\"selector\":\"@a\"}]}");
+    }
+
+    @Test(expected = DecoderException.class)
+    public void rejectsNull() {
+        PacketPlayInUpdateSign.readLiteralLine("null");
+    }
+
+    @Test(expected = DecoderException.class)
+    public void rejectsMalformedText() {
+        PacketPlayInUpdateSign.readLiteralLine("{\"text\":{}}");
+    }
+
+    @Test
+    public void decodesFourVanillaSignLines() throws Exception {
+        PacketDataSerializer buffer = new PacketDataSerializer(Unpooled.buffer());
+        try {
+            buffer.a(new BlockPosition(10, 64, -10));
+            for (int i = 0; i < 4; ++i) buffer.a("{\"text\":\"line " + i + "\"}");
+            PacketPlayInUpdateSign packet = new PacketPlayInUpdateSign();
+            packet.a(buffer);
+            assertEquals(new BlockPosition(10, 64, -10), packet.a());
+            for (int i = 0; i < 4; ++i) assertEquals("line " + i, packet.b()[i].c());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test(expected = DecoderException.class)
+    public void enforcesWireLengthBeforeParsing() throws Exception {
+        PacketDataSerializer buffer = new PacketDataSerializer(Unpooled.buffer());
+        try {
+            buffer.a(new BlockPosition(0, 0, 0));
+            buffer.a(new String(new char[385]).replace('\0', 'x'));
+            new PacketPlayInUpdateSign().a(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+}
