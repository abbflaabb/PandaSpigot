From acf6f59a54aaacf75a5c267321c2dacbc3426e90 Mon Sep 17 00:00:00 2001
From: Manus <dev-agent@manus.ai>
Date: Sat, 17 Oct 2026 00:17:34 +0300
Subject: [PATCH] Skip knockback packets for players in vehicles

Co-authored-by: Manus <dev-agent@manus.ai>
---
 src/main/java/net/minecraft/server/EntityHuman.java | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/minecraft/server/EntityHuman.java b/src/main/java/net/minecraft/server/EntityHuman.java
index 524ff60ad..584a2aa09 100644
--- a/src/main/java/net/minecraft/server/EntityHuman.java
+++ b/src/main/java/net/minecraft/server/EntityHuman.java
@@ -1039,7 +1039,9 @@ public abstract class EntityHuman extends EntityLiving {
                             }
 
                             if (!cancelled) {
-                                ( (EntityPlayer) entity ).playerConnection.sendPacket( new PacketPlayOutEntityVelocity( entity ) );
+                                if (entity.vehicle == null) {
+                                    ( (EntityPlayer) entity ).playerConnection.sendPacket( new PacketPlayOutEntityVelocity( entity ) ); // PandaSpigot - Do not send knockback packets while the player is in a vehicle
+                                }
                                 entity.velocityChanged = false;
                                 entity.motX = d0;
                                 entity.motY = d1;
-- 
